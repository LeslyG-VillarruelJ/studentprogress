<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/studentprogress/db" VERSION="2025071700" COMMENT="Instalación de tablas del plugin studentprogress" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../lib/xmldb/xmldb.xsd">
    <TABLES>

        <TABLE NAME="course_duration_plg" COMMENT="Duración por curso">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="id_course" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="duration" TYPE="int" LENGTH="10" NOTNULL="true"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="id_course_ix" UNIQUE="false" FIELDS="id_course"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="course_alerts_plg" COMMENT="Alertas por curso">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="id_course" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="alert" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT=""/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="id_course_ix" UNIQUE="false" FIELDS="id_course"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="learning_type_plg" COMMENT="Tipos de aprendizaje">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="name" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT=""/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>

        <TABLE NAME="learning_course_module_plg" COMMENT="Relación entre módulo y tipo de aprendizaje">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="id_course_module" TYPE="int" LENGTH="20" NOTNULL="true"/>
                <FIELD NAME="id_learning" TYPE="int" LENGTH="10" NOTNULL="true"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="fk_course_module" TYPE="foreign" FIELDS="id_course_module" REFTABLE="course_modules" REFFIELDS="id"/>
                <KEY NAME="fk_learning_type" TYPE="foreign" FIELDS="id_learning" REFTABLE="learning_type_plg" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="idx_course_module" UNIQUE="false" FIELDS="id_course_module"/>
                <INDEX NAME="idx_learning" UNIQUE="false" FIELDS="id_learning"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="user_learning_plg" COMMENT="Asignación de tipos de aprendizaje a usuarios">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="id_user" TYPE="int" LENGTH="20" NOTNULL="true"/>
                <FIELD NAME="id_learning" TYPE="int" LENGTH="10" NOTNULL="true"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="fk_user" TYPE="foreign" FIELDS="id_user" REFTABLE="user" REFFIELDS="id"/>
                <KEY NAME="fk_learning" TYPE="foreign" FIELDS="id_learning" REFTABLE="learning_type_plg" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="idx_user" UNIQUE="false" FIELDS="id_user"/>
                <INDEX NAME="idx_learning" UNIQUE="false" FIELDS="id_learning"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="user_learning_module_plg" COMMENT="Módulos asignados a usuarios por tipo de aprendizaje">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="id_user_learning" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="id_learning_course_module" TYPE="int" LENGTH="10" NOTNULL="true"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="fk_user_learning" TYPE="foreign" FIELDS="id_user_learning" REFTABLE="user_learning_plg" REFFIELDS="id"/>
                <KEY NAME="fk_learning_module" TYPE="foreign" FIELDS="id_learning_course_module" REFTABLE="learning_course_module_plg" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="idx_user_learning" UNIQUE="false" FIELDS="id_user_learning"/>
                <INDEX NAME="idx_learning_module" UNIQUE="false" FIELDS="id_learning_course_module"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="user_section_grades_plg" COMMENT="Notas por sección">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="id_section" TYPE="int" LENGTH="20" NOTNULL="true"/>
                <FIELD NAME="id_user_learning" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="grade" TYPE="number" LENGTH="5,2" NOTNULL="true" DEFAULT="0"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="fk_section" TYPE="foreign" FIELDS="id_section" REFTABLE="course_sections" REFFIELDS="id"/>
                <KEY NAME="fk_user_learning_gr" TYPE="foreign" FIELDS="id_user_learning" REFTABLE="user_learning_plg" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="idx_section" UNIQUE="false" FIELDS="id_section"/>
                <INDEX NAME="idx_user_learning" UNIQUE="false" FIELDS="id_user_learning"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="user_section_status_plg" COMMENT="Estado por sección">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="id_section" TYPE="int" LENGTH="20" NOTNULL="true"/>
                <FIELD NAME="id_user_learning" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="status" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT=""/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="fk_section_status" TYPE="foreign" FIELDS="id_section" REFTABLE="course_sections" REFFIELDS="id"/>
                <KEY NAME="fk_user_learning_status" TYPE="foreign" FIELDS="id_user_learning" REFTABLE="user_learning_plg" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="idx_section" UNIQUE="false" FIELDS="id_section"/>
                <INDEX NAME="idx_user_learning" UNIQUE="false" FIELDS="id_user_learning"/>
            </INDEXES>
        </TABLE>

    </TABLES>
</XMLDB>
